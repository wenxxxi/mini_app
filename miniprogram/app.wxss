page {
  --bg: #f7f7f8;
  --surface: #ffffff;
  --surface-muted: #efeff2;
  --text: #171717;
  --text-muted: #52525b;
  --border: rgba(23, 23, 23, 0.1);
  --brand: #0f9d58;
  --brand-soft: #e8f8ef;
  --danger: #e8463a;
  --radius: 16rpx;
  --radius-card: 24rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row + .row {
  margin-top: 20rpx;
}

.muted {
  color: var(--text-muted);
  font-size: 24rpx;
}

.value {
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.mono {
  font-family: "SF Mono", Menlo, monospace;
  font-variant-numeric: tabular-nums;
}

.pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  color: var(--text-muted);
  font-size: 22rpx;
}

.pill-brand {
  background: var(--brand-soft);
  color: var(--brand);
}

.btn {
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--text);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  line-height: 1.4;
}

.btn-primary {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
}

.btn-danger {
  color: var(--danger);
  border-color: rgba(232, 70, 58, 0.35);
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-row .btn {
  flex: 1;
  text-align: center;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

.meal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.meal-row:last-child {
  border-bottom: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx 48rpx;
  max-height: 82vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.input {
  background: var(--surface-muted);
  border-radius: var(--radius);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface-muted);
  font-size: 32rpx;
}
