.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--border);
  font-size: 36rpx;
  color: var(--text-muted);
}

.date-center {
  text-align: center;
}

.date-text {
  font-size: 30rpx;
  font-weight: 500;
}

.picker-value {
  color: var(--text);
  background: var(--surface-muted);
  border-radius: var(--radius);
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.mood-row {
  display: flex;
  gap: 12rpx;
}

.mood {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
}

.mood.on {
  background: var(--brand);
  border-color: var(--brand);
}

.star-block {
  padding: 16rpx 0;
}

.star-block + .star-block {
  border-top: 1rpx solid var(--border);
}

.star-title {
  font-size: 28rpx;
  font-weight: 500;
}

.star-meta {
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  margin-top: 12rpx;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: var(--brand);
  border-radius: 999rpx;
}

.food-block {
  background: var(--surface-muted);
  border-radius: var(--radius);
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.food-name {
  flex: 1;
  margin-right: 12rpx;
  background: var(--surface);
}

.food-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.food-grid .input {
  flex: 1;
  background: var(--surface);
}

.remove {
  color: var(--danger);
  font-size: 24rpx;
  padding: 0 8rpx;
}

.add-food {
  text-align: center;
  margin-bottom: 24rpx;
}
