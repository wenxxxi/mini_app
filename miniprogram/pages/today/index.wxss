.hero-date {
  font-size: 34rpx;
  font-weight: 600;
}

.hero-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-item {
  flex: 1;
  background: var(--surface-muted);
  border-radius: var(--radius);
  padding: 18rpx;
}

.hero-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.star-line + .star-line {
  margin-top: 24rpx;
}

.star-title {
  font-size: 28rpx;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  margin-top: 12rpx;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: var(--brand);
  border-radius: 999rpx;
}

.count-title {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.count-value {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 600;
}

.count-value.past {
  font-size: 36rpx;
  color: var(--text-muted);
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-muted);
  margin: 0 4rpx;
}

.summary {
  white-space: pre-wrap;
  color: var(--text);
}

.full {
  width: 100%;
  margin-top: 8rpx;
}
